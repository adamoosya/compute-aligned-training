{
  "schema_version": 1,
  "name": "math_rl_passn_warmup",
  "initialization": "base",
  "model": {
    "name": "mistralai/Mistral-7B-Instruct-v0.2",
    "revision": null,
    "device": "cuda:0",
    "precision": "fp16",
    "quantization": "nf4",
    "gradient_checkpointing": true,
    "attention": "sdpa"
  },
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.0,
    "target_modules": [
      "q_proj",
      "v_proj"
    ]
  },
  "data": {
    "dataset_name": "nlile/hendrycks-MATH-benchmark",
    "revision": null,
    "split": "train",
    "max_examples": 2000,
    "levels": null,
    "target": "solution",
    "seed": 42,
    "max_length": 1024,
    "overflow": "truncate_target",
    "prompt_template": "Problem:\n{problem}"
  },
  "objective": {
    "strategy": "ce",
    "n": 1,
    "k": null,
    "reduction": "token_mean"
  },
  "training": {
    "epochs": 1,
    "microbatch_size": 1,
    "accumulation_steps": 4,
    "learning_rate": 5e-06,
    "weight_decay": 0.01,
    "max_grad_norm": 0.3,
    "seed": 42
  }
}
