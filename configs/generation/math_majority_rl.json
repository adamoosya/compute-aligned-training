{
  "schema_version": 1,
  "name": "math_majority_rl_generation",
  "initialization": "adapter",
  "model": {
    "name": "mistralai/Mistral-7B-Instruct-v0.2",
    "revision": null,
    "device": "cuda:0",
    "precision": "fp16",
    "quantization": "nf4",
    "gradient_checkpointing": false,
    "attention": "sdpa"
  },
  "data": {
    "dataset_name": "nlile/hendrycks-MATH-benchmark",
    "revision": null,
    "split": "test",
    "max_examples": 500,
    "levels": [
      1,
      2,
      3
    ],
    "seed": 42
  },
  "sampling": {
    "num_candidates": 16,
    "chunk_size": 4,
    "max_prompt_tokens": 256,
    "max_new_tokens": 512,
    "temperature": 0.8,
    "top_p": 0.95,
    "top_k": 0,
    "seed": 42,
    "prompt_template": "Problem:\n{problem}"
  },
  "scoring": {
    "schema_version": 1,
    "budgets": [
      1,
      4,
      8,
      16
    ],
    "majority_trials": 500,
    "seed": 42,
    "extraction": "boxed_or_last_number",
    "tie_break": "first",
    "atol": 0.0001
  }
}
